---
import Layout from '../layouts/Layout.astro';
import Dashboard from '../components/Dashboard.vue';
---

<Layout title="PubliMetrics - Extraction HAL/DBLP">
	<div class="mb-8">
		<h2 class="text-2xl font-bold text-slate-900">Extraction et Classement</h2>
		<p class="text-slate-600 mt-1">
			Générez des rapports de publications automatiquement classées via CORE et SCIMAGO.
		</p>
	</div>

    <!-- On utilise client:load pour que Vue hydrate ce composant dès le chargement de la page -->
	<Dashboard client:load />
</Layout>