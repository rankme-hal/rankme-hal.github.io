---
import "../styles/global.css";
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Générateur de publications scientifiques" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col">
		<!-- Header / Navbar -->
		<header class="bg-white border-b border-slate-200 shadow-sm sticky top-0 z-10">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
				<div class="flex items-center gap-2">
                    <!-- Tu peux mettre un logo SVG ici -->
					<div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center text-white font-bold text-xl">
                        P
                    </div>
					<h1 class="text-xl font-bold text-slate-900">PubliMetrics</h1>
				</div>
			</div>
		</header>

		<!-- Main Content -->
		<main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
			<slot />
		</main>

		<!-- Footer -->
		<footer class="bg-white border-t border-slate-200 mt-auto">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 text-center text-sm text-slate-500">
				&copy; {new Date().getFullYear()} - Générateur de publications avec classements CORE & SCIMAGO.
			</div>
		</footer>
	</body>
</html>